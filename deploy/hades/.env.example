# Platehouse on Hades: the variables docker-compose.yml reads (build plan
# Task 26). Names only. Copy this file to .env beside the compose file and
# fill each value in. Every secret comes from 1Password or a random
# generator, never from this file, a commit or a chat. A value left empty is
# the server's default where one is named below, and a refused start (the
# key named, never its value) where none is.
#
# Values that are not secret are given in the comments. They come from the
# 2026-11-08 gate report and the plan's Configuration contract.

# --- Compose: names, host, paths, Traefik (Docker Compose Conventions) ---

# Service and container name, and the prefix for the slicer and db: platehouse
NAME=
# Subdomain of the public origin and the Traefik host rule: platehouse
SUB=
# Domain the certificate covers: local.jonco.dev
DOMAIN=
# Bind-mount root on Hades: /opt/projects/docker/appdata
APPDATA=
# The app's internal port, for both the server and Traefik's load balancer: 3000
PORT=
# Time zone for the app's 03:30 and 04:00 jobs and for Postgres; the one the other Hades .env files use
TZ=
# Source CIDRs the allowlist admits, LAN and tailnet: 10.1.50.0/24,100.64.0.0/10
IP_ALLOWLIST=

# --- Database (postgres:17-alpine; the app's DATABASE_URL is built from these) ---

# Database name: platehouse
DB_NAME=
# Database user: platehouse
DB_USER=
# From a random generator, URL-safe characters only (it goes into DATABASE_URL), e.g. openssl rand -hex 32
DB_PASS=

# --- Object storage (AC-010; Jon supplies these from 1Password) ---

# The S3-compatible endpoint, an http or https URL
S3_ENDPOINT=
# The bucket's region
S3_REGION=
# Platehouse's own bucket
S3_BUCKET=
# Access key ID for the bucket, from 1Password
S3_ACCESS_KEY_ID=
# Secret access key for the bucket, from 1Password
S3_SECRET_ACCESS_KEY=
# true or false: true when the store needs path-style bucket URLs
S3_FORCE_PATH_STYLE=

# --- Login (Pocket ID on Mario; Jon registers the client and keeps it in 1Password) ---

# Pocket ID issuer URL, required: the server has no default and refuses to start without it. Hades: https://id.local.jonco.dev
OIDC_ISSUER=
# Client ID of the platehouse client, from 1Password
OIDC_CLIENT_ID=
# Client secret of the platehouse client, from 1Password
OIDC_CLIENT_SECRET=
# Pocket ID group allowed to log in; empty means platehouse
OIDC_GROUP=

# --- Links and sessions ---

# From a random generator, at least 32 bytes, e.g. openssl rand -base64 48; changing it ends live slicer links and logins
LINK_SECRET=

# --- Slicing and the inbox ---

# Orca's per-plate cap in seconds, given to both the app and the slicer: 120 (the gate's worst plate took 55.31 s)
SLICE_PLATE_SECONDS=
# Seconds a file must sit unchanged in the inbox before import; empty means 15
INBOX_SETTLE_SECONDS=

# --- Read by the server but set in docker-compose.yml; do not add them here ---
# PUBLIC_ORIGIN: https://${SUB}.${DOMAIN}
# DATABASE_URL: built from DB_USER, DB_PASS, NAME and DB_NAME
# SLICER_URL: http://${NAME}-slicer:8080
# INBOX_DIR: /data/inbox, the inbox bind mount
# TMP_DIR: /data/tmp, the tmp bind mount

# --- Read by the slicer and left at its image's defaults; do not add them here ---
# PORT: 8080, the slicer's own port (the compose file never passes the app's PORT to it)
# WORK_DIR: /work, the tmpfs
# PROFILES_DIR: the flattened Orca profiles in the image
# ORCA_BIN: the OrcaSlicer AppImage launcher
# TIME_BIN: GNU time, for Orca's peak memory
# OPENSCAD_BIN: the OpenSCAD AppImage launcher
# OPENSCAD_DIR: the OpenSCAD tree landrun lets it run from
# LANDRUN_BIN: the landrun sandbox
# PRLIMIT_BIN: util-linux prlimit, for OpenSCAD's kernel limits
# SANDBOX_PROBE: the file the sandbox self-test must fail to read
# STEP_WORKER: the STEP-to-GLB worker module
# SLICE_TIMEOUT_SECONDS: when the slicer kills a plate; default SLICE_PLATE_SECONDS + 60
# SCAD_TIMEOUT_SECONDS: OpenSCAD's cap; default 120
# STEP_TIMEOUT_SECONDS: the STEP converter's cap; default 120
# WORK_MIN_FREE_MIB: /v1/health fails below this much free /work while idle; default 640
# ORCA_VERSION: set by the image build, reported in /v1/health
# OPENSCAD_VERSION: set by the image build, reported in /v1/health
