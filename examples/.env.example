# Platehouse example settings. Copy this file to .env beside
# docker-compose.yml and fill in every value. Never commit the filled-in .env.
# The Configuration page of the documentation explains each one.

# Your time zone, used for the daily jobs (trash purge 03:30, cleanup 04:00).
TZ=Etc/UTC

# The address people use to open Platehouse: https, the host name, no path and
# no trailing slash. Every link Platehouse builds starts with this.
PUBLIC_ORIGIN=https://platehouse.example.com

# Postgres. DB_PASS goes into the app's database URL as it is, so use only
# letters and digits: make one with  openssl rand -hex 32
# Other characters can break the URL: with / # or ? the app usually refuses
# to start ("DATABASE_URL must be a postgres:// or postgresql:// URL"), but
# with an @ before one of them it starts and connects to the wrong host, and
# with % and two hex digits it starts and cannot connect. To use such a
# password anyway, you would have to percent-encode it in DATABASE_URL in
# docker-compose.yml (every %, too, as %25) and keep it as it is in
# POSTGRES_PASSWORD. See the Configuration page.
DB_NAME=platehouse
DB_USER=platehouse
DB_PASS=

# Your S3-compatible bucket. See the Storage page.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=platehouse
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for most self-hosted stores (MinIO, Garage, Ceph), false for AWS S3.
S3_FORCE_PATH_STYLE=true

# Your OpenID Connect provider. See the Sign-in page.
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only members of this group may sign in.
OIDC_GROUP=platehouse

# At least 32 bytes. Signs the slicer links and the login cookie.
# Make one with: openssl rand -base64 48
LINK_SECRET=

# Optional. Seconds OrcaSlicer may spend on one plate before it is stopped.
SLICE_PLATE_SECONDS=120
# Optional. Seconds a file in the inbox must stay unchanged before import.
INBOX_SETTLE_SECONDS=15
